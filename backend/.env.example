SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=
PORT=4000

# Code 3 owner authentication and exact-origin CORS. Use provider-qualified
# immutable subjects, for example supabase:<user-id>. Do not place real values
# in this example file.
CODE3_OWNER_SUBJECTS=
CODE3_CORS_ALLOWED_ORIGINS=
CODE3_CORS_PREVIEW_ORIGINS=
CODE3_CORS_LOCAL_ORIGINS=
CODE3_ENABLE_LOCAL_DEV_AUTH=false
CODE3_CANONICAL_PERSISTENCE_ENABLED=false

# Phase 2B2-B managed mailbox-provider security state. Preview-only until a
# separate Production review. Values remain server-side and outside backups.
CODE3_PROVIDER_MANAGED_STORE_ENABLED=false
CODE3_PROVIDER_PREVIEW_PROJECT_ID=
CODE3_PROVIDER_PREVIEW_GIT_BRANCH=
CODE3_PROVIDER_KV_REST_API_URL=
CODE3_PROVIDER_KV_REST_API_TOKEN=
CODE3_PROVIDER_SECRET_ENCRYPTION_KEY=
CODE3_PROVIDER_SECRET_KEY_VERSION=v1
CODE3_PROVIDER_OAUTH_REDIRECT_URIS=
CODE3_PROVIDER_STORE_NAMESPACE=code3:provider:v1:preview

# Server-only. Never expose this as a VITE_* variable.
BESTBUY_API_KEY=
BESTBUY_API_BASE_URL=https://api.bestbuy.com/v1
BESTBUY_MONITOR_ENABLED=false
BESTBUY_MONITOR_QUERY=pokemon tcg
BESTBUY_MONITOR_ZIP=
BESTBUY_MONITOR_SKUS=
BESTBUY_ALERT_ONLY_ON_CHANGE=true
BESTBUY_DISCORD_WEBHOOK_URL=
BESTBUY_MONITOR_SECRET=

# Flip Scout eBay Browse API (server-only).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=production
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_REQUEST_TIMEOUT_MS=8000
