# Public frontend configuration. Add these to Vercel Production and Preview.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_APP_URL=

# Server-side Code 3 owner boundary. Values are configured separately for
# Preview and Production; never expose the owner subject list to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
CODE3_OWNER_SUBJECTS=
CODE3_CORS_ALLOWED_ORIGINS=
CODE3_CORS_PREVIEW_ORIGINS=
CODE3_CORS_LOCAL_ORIGINS=
CODE3_ENABLE_LOCAL_DEV_AUTH=false

# Server-only. Mark this value Sensitive in Vercel and never prefix it with VITE_.
DATABASE_URL=

# Flip Scout eBay connector. All EBAY_* variables are server-only; never add a VITE_ prefix.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=production
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_REQUEST_TIMEOUT_MS=8000

# Deployment candidates must keep all QA bypasses disabled.
VITE_CODE3_LOCAL_AUTH_ENABLED=false
VITE_BETA_LOCAL_MODE=false
VITE_QA_UNLOCK_PAID_FEATURES=false
